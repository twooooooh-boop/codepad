<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        app:tabIndicatorHeight="2dp"
        app:tabMinWidth="0dp"
        app:tabMode="scrollable" />

    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/find_input"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Find"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/find_count"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:minWidth="44dp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/find_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="▲"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/find_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="▼"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/find_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="✕"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/replace_input"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Replace with"
                android:imeOptions="flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/find_replace"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Replace"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/find_replace_all"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="All"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/find_case"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="Aa"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/find_regex"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text=".*"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <com.forai.codepad.EditorView
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="top|start"
        android:imeOptions="flagNoExtractUi|flagNoFullscreen"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:id="@+id/symbol_scroll"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/symbol_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="11sp" />
</LinearLayout>
