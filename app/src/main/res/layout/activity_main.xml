<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <LinearLayout
        android:id="@+id/tab_row"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:tabIndicatorHeight="2dp"
            app:tabMinWidth="0dp"
            app:tabMode="scrollable" />

        <ImageView
            android:id="@+id/btn_new"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:contentDescription="New file"
            android:padding="9dp"
            android:src="@drawable/ic_add" />

        <ImageView
            android:id="@+id/btn_open"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:contentDescription="Open file"
            android:padding="9dp"
            android:src="@drawable/ic_open" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/find_input"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Find"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/find_count"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:minWidth="44dp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/find_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="▲"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/find_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="▼"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/find_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="✕"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/replace_input"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Replace with"
                android:imeOptions="flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/find_replace"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Replace"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/find_replace_all"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="All"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/find_case"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="Aa"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/find_regex"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text=".*"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/content_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/editor_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.forai.codepad.EditorView
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:gravity="top|start"
                android:imeOptions="flagNoExtractUi|flagNoFullscreen"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:scrollbars="vertical"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/viewer_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/viewer_bar"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp">

                    <TextView
                        android:id="@+id/viewer_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/viewer_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Hex"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/viewer_find"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Find"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/viewer_goto"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Go to"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/viewer_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:text="Edit"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.forai.codepad.LargeFileView
                    android:id="@+id/viewer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/welcome_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:id="@+id/welcome_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:text="CodePad"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/welcome_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="28dp"
                        android:text="Open a file or a folder to start"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/w_new"
                        android:layout_width="240dp"
                        android:layout_height="46dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center"
                        android:text="New file"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/w_open"
                        android:layout_width="240dp"
                        android:layout_height="46dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center"
                        android:text="Open file…"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/w_folder"
                        android:layout_width="240dp"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:text="Open folder…"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/w_recent_header"
                        android:layout_width="240dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:paddingBottom="6dp"
                        android:text="RECENT"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/w_recent"
                        android:layout_width="240dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/explorer_panel"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/explorer_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="EXPLORER"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ex_new_file"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="+File"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/ex_new_folder"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="+Folder"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/ex_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="↻"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/ex_open"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:text="Open"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/explorer_empty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/ex_empty_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="No folder opened"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/ex_empty_open"
                        android:layout_width="200dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="Open folder…"
                        android:textSize="14sp" />
                </LinearLayout>

                <ListView
                    android:id="@+id/explorer_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@null" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/explorer_handle"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/output_panel"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/output_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Output"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/output_rerun"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▶"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/output_clear"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Clear"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/output_close"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✕"
                android:textSize="15sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/output_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/output_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:typeface="monospace" />
        </ScrollView>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/symbol_scroll"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/symbol_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="11sp" />
</LinearLayout>
