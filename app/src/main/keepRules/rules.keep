# R8 rules for CodePad release builds.
# Keep our own code and its readable names, so crash reports stay readable. Only libraries are shrunk.
-dontobfuscate
-keepattributes SourceFile,LineNumberTable,*Annotation*
-keep class com.forai.codepad.** { *; }

# WebView JavaScript bridges (plugin host and JS sandbox)
-keepclassmembers class * {
    @android.webkit.JavascriptInterface <methods>;
}
